# Supabase — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to the browser

# Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from Stripe CLI or the webhook endpoint you create
STRIPE_PRICE_STARTER=price_...                     # created in Stripe Dashboard > Products
STRIPE_PRICE_PRO=price_...

PORT=3000
CLIENT_URL=https://your-frontend-domain.com
